# ================= JWT =================
# Replace with your own secret key (minimum 256 bits / 32+ characters)
JWT__Key=your-jwt-secret-key-min-32-chars
JWT__Issuer=StudyStudio.Api
JWT__Audience=StudyStudio.Client
JWT__AccessTokenExpireMs=3600000
JWT__RefreshTokenExpireMs=86400000

# ================= Database =================
# PostgreSQL connection string (for Docker, use 'postgres' as host)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=study_studio;Username=postgres;Password=your-postgres-password
POSTGRES_PASSWORD=your-postgres-password

# ================= Google OAuth =================
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
Google__ClientId=your-google-client-id.apps.googleusercontent.com

# ================= Email =================
# Use App Password for Gmail (enable 2FA → create App Password)
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=your-email@gmail.com
Email__Password=your-app-password
Email__From=your-email@gmail.com

# ================= FrontEnd =================
Frontend__VerifyURL=http://localhost:3000/verify-email
Frontend__ResetPassURL=http://localhost:3000/verify-reset-token
Frontend__BaseUrl=http://localhost:3000

# ================= Report =================
# Email address that receives system reports
Report__ToEmail=admin@example.com

# ================= Redis =================
# For Docker: use 'redis' as hostname (service name from docker-compose)
# For local: use 'localhost'
ConnectionStrings__Redis=redis:6379,abortConnect=False

# ================= Admin Account =================
# Change these before deploying to production
Admin__Email=admin@studystudio.com
Admin__Password=Admin@123456
Admin__FirstName=Admin
Admin__LastName=User

# ================= PayOS =================
# Get credentials from https://payos.vn/ (Vietnamese payment gateway)
PayOS__ClientId=your-payos-client-id
PayOS__ApiKey=your-payos-api-key
PayOS__ChecksumKey=your-payos-checksum-key

# ================= Backblaze B2 =================
# Create B2 application key at https://www.backblaze.com/b2/cloud-storage.html
BACKBLAZE__SERVICEURL=https://s3.eu-central-003.backblazeb2.com
BACKBLAZE__KEYID=your-b2-key-id
BACKBLAZE__APPKEY=your-b2-application-key
BACKBLAZE__BUCKETNAME=your-bucket-name
BACKBLAZE__REGION=eu-central-003

# ================= Qdrant (Vector DB) =================
# Create a free cluster at https://cloud.qdrant.io/ or self-host
QDRANT__ENDPOINT=https://your-qdrant-endpoint.gcp.cloud.qdrant.io
QDRANT__APIKEY=your-qdrant-api-key
QDRANT__COLLECTIONNAME=studystudio_documents
QDRANT__VECTORSIZE=768
QDRANT__TIMEOUTSECONDS=10

# ================= Gemini AI =================
# Get API key at https://aistudio.google.com/apikey
GEMINI__APIKEY=your-gemini-api-key
GEMINI__MODEL=gemini-embedding-001
GEMINI__OUTPUTDIMENSIONALITY=768
GEMINI__EXPECTEDDIMENSION=768
GEMINI__TIMEOUTSECONDS=30
GEMINI__RETRYATTEMPTS=3
GEMINI__RETRYDELAYMS=500
GEMINI__MAXBATCHSIZE=8
GEMINI__MAXTEXTLENGTH=10000
GEMINI__DELAYBETWEENREQUESTSMS=0
GEMINI__MAXTOKENSPERMINUTE=800000
GEMINI__MAXREQUESTSPERMINUTE=2900
GEMINI__ENABLETOKENRATELIMITING=true
GEMINI__MAXCONCURRENTDOCUMENTS=1
GEMINI__LLMTIMEOUTSECONDS=60
GEMINI__MAXTOKENS=2048
GEMINI__TEMPERATURE=0.7
GEMINI__TOPP=0.95
GEMINI__TOPK=40