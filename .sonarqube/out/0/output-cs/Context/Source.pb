    /// </summary>
    public class RevenueByPeriodRequest
    {
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Period { get; set; } = "daily"; // "daily" | "weekly" | "monthly" | "yearly"
