            return $@"
<!DOCTYPE html>
<html lang=""{(language == Language.Vietnamese ? "vi" : "en")}"">
<head>
  <meta charset=""UTF-8"" />
  <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"" />
