        public const string RevenueInvalidPeriod = "REVENUE002";
        public const string RevenueInvalidCustomPeriod = "REVENUE003";
        public const string RevenueInvalidLimit = "REVENUE004";

        // COMMON
        public const string UnexpectedError = "SYS001";
        public const string ApiRateLimitExceeded = "API001";

        // ANALYTICS
        public const string AnalyticsNotFound = "ANALYTICS001";
        public const string InvalidDateRange = "ANALYTICS002";
        public const string InsufficientData = "ANALYTICS003";

        // PERSONAL ANALYTICS
        public const string PersonalAnalyticsNoGroups = "ANALYTICSP001";
    }
