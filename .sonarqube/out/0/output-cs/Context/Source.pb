    ///
    /// Activity Level Thresholds (FIXED, not dynamic):
    ///   0 = 0 (No activity)
    ///   1 = 1-5 score
    ///   2 = 6-15 score
    ///   3 = 16-30 score
    ///   4 = 31+ score
    /// </summary>
    public class StudioGroupActivityResponse
    {
        public List<StudioActivityRow> Data { get; set; } = new();
    }

