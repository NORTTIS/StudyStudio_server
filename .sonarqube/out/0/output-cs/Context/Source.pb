        public int MaxStudios { get; set; }

        [Required(ErrorMessage = ErrorCodes.ValidationRequiredField)]
        [Range(1, int.MaxValue, ErrorMessage = ErrorCodes.ValidationInvalidRange)]
        public int MaxStorageMb { get; set; }

        [Required(ErrorMessage = ErrorCodes.ValidationRequiredField)]
