        .CreateHistogram("studystudio_external_service_latency_seconds", "External service latency in seconds",
            new HistogramConfiguration
            {
                LabelNames = new[] { "service" },
                Buckets = new[] { 0.01, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0 }
            });
}
