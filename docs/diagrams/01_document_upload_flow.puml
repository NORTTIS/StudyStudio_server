@startuml Document Upload & Embedding Flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Document Upload & Embedding Pipeline\n(Backend Processing Flow)

actor Frontend as FE
participant "DocumentController" as DC
participant "DocumentService" as DS
participant "GroupParticipantRepo" as GPR
participant "FileStorageService\n(Backblaze B2)" as B2
participant "GroupAttachmentRepo" as GAR
database "PostgreSQL" as PG
participant "BackgroundJob" as BG
participant "EmbeddingService\n(Gemini)" as ES
participant "VectorDBService\n(Qdrant)" as QD

== Step 1: Request Upload URL ==

FE -> DC: POST /api/documents/request-upload\n{groupId, fileName, contentType, fileSize}
activate DC

DC -> DC: ValidateAndGetUserId()\nExtract userId from JWT

DC -> DS: RequestUploadAsync(userId, request)
activate DS

DS -> GPR: IsUserInGroupAsync(groupId, userId)
activate GPR
GPR -> PG: SELECT FROM GroupParticipants\nWHERE groupId AND userId
GPR <-- PG: true/false
DS <-- GPR: isMember
deactivate GPR

alt User không ph?i member
    DS -> DC: throw GroupPermissionDenied
    DC -> FE: 403 Forbidden
end

DS -> DS: Validate file extension\n(.pdf, .txt, .docx, .md, .doc)

DS -> DS: Validate content type

DS -> DS: Validate file size (max 10MB)

DS -> DS: attachmentId = Guid.NewGuid()\nfileKey = "group_{groupId}/doc_{attachmentId}.ext"

DS -> GAR: CreateAsync(attachment)
activate GAR
GAR -> PG: INSERT INTO GroupAttachments\n(id, groupId, fileName, status=Uploading)
GAR <-- PG: ?
DS <-- GAR: ?
deactivate GAR

DS -> B2: GeneratePresignedUploadUrlAsync(fileKey, 60 mins)
activate B2
B2 -> B2: Generate presigned PUT URL\nExpires in 60 minutes
DS <-- B2: presignedUrl
deactivate B2

DC <-- DS: RequestDocumentUploadResponse\n{attachmentId, uploadUrl, fileKey}
deactivate DS

FE <-- DC: 200 OK\n{attachmentId, uploadUrl, expiresIn}
deactivate DC

== Step 2: Direct File Upload ==

FE -> B2: PUT {uploadUrl}\n[File Binary Data]
activate B2
note right: File KHÔNG ði qua backend\nTi?t ki?m bãng thông VPS
B2 -> B2: Store file
FE <-- B2: 200 OK
deactivate B2

== Step 3: Complete Upload ==

FE -> DC: POST /api/documents/{attachmentId}/complete
activate DC

DC -> DC: ValidateAndGetUserId()

DC -> DS: CompleteUploadAsync(userId, attachmentId)
activate DS

DS -> GAR: GetByIdAsync(attachmentId)
activate GAR
GAR -> PG: SELECT FROM GroupAttachments
GAR <-- PG: attachment
DS <-- GAR: attachment
deactivate GAR

alt Attachment không t?n t?i ho?c userId khác
    DS -> DC: throw NotFound / PermissionDenied
    DC -> FE: 404/403
end

DS -> B2: FileExistsAsync(fileUrl)
activate B2
B2 -> B2: Check file exists
DS <-- B2: true/false
deactivate B2

alt File không t?n t?i trên B2
    DS -> DC: throw BadRequest
    DC -> FE: 400 Bad Request
end

DS -> GAR: UpdateAsync(attachment)\nstatus = Processing
activate GAR
GAR -> PG: UPDATE GroupAttachments\nSET ProcessingStatus = Processing
GAR <-- PG: ?
DS <-- GAR: ?
deactivate GAR

DS -> BG: Task.Run(() => ProcessDocumentAsync(attachmentId))
note right of DS: Fire & Forget\nKhông ch? k?t qu?

DC <-- DS: ?
deactivate DS

FE <-- DC: 200 OK\n{message: "Processing started"}
deactivate DC

== Step 4: Background Processing ==

BG -> BG: ProcessDocumentAsync(attachmentId)
activate BG

BG -> GAR: GetByIdAsync(attachmentId)
activate GAR
GAR -> PG: SELECT FROM GroupAttachments
GAR <-- PG: attachment
BG <-- GAR: attachment
deactivate GAR

BG -> B2: DownloadFileAsync(fileUrl)
activate B2
B2 -> B2: GetObject from bucket
BG <-- B2: FileStream
deactivate B2

BG -> BG: ExtractTextAsync(stream, fileName)\n- .txt/.md: Direct read\n- .pdf: TODO\n- .docx: TODO

BG -> BG: ChunkText(fullText, 3200 chars)\nStrategy: Split by paragraphs\nMax ~800 tokens per chunk

note right of BG
**Chunking Strategy:**
1. Split by \n\n (paragraphs)
2. Max 3200 chars per chunk
3. If paragraph > 3200, split further
end note

BG -> ES: GenerateBatchEmbeddingsAsync(chunks)
activate ES

loop For each chunk
    ES -> ES: Call Gemini API\nmodel: text-embedding-004
    ES -> ES: Receive 768-dim vector
end

BG <-- ES: List<float[]> embeddings
deactivate ES

== Step 5: Upsert to Qdrant ==

loop For each chunk (i = 0 to chunks.Count)
    BG -> BG: vectorId = "{groupId}_{docId}_{i}"
    
    BG -> BG: Build payload:\n- groupId, documentId, userId\n- chunkIndex, chunkCount\n- content, fileName\n- embeddingModel, createdAt\n- deleted: false
    
    BG -> QD: UpsertVectorAsync(vectorId, embedding[i], payload)
    activate QD
    QD -> QD: POST /collections/{name}/points/upsert\nStore 768-dim vector + metadata
    BG <-- QD: ?
    deactivate QD
end

BG -> GAR: UpdateAsync(attachment)\nstatus = Completed\nchunkCount = chunks.Count\nprocessedAt = now
activate GAR
GAR -> PG: UPDATE GroupAttachments\nSET ProcessingStatus = Completed
GAR <-- PG: ?
BG <-- GAR: ?
deactivate GAR

note right of BG
**Processing Complete**
Time: 5-15 seconds
Chunks created
Vectors stored in Qdrant
end note

deactivate BG

== Error Handling ==

alt Processing Failed
    BG -> GAR: UpdateAsync(attachment)\nstatus = Failed\nerrorMessage = ex.Message
    activate GAR
    GAR -> PG: UPDATE GroupAttachments
    GAR <-- PG: ?
    BG <-- GAR: ?
    deactivate GAR
end

@enduml
