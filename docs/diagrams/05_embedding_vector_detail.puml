@startuml Embedding & Vector Storage Detail
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

title Embedding Generation & Vector Storage Detail

participant "DocumentService" as DS
participant "GeminiEmbeddingService" as GES
participant "Gemini API" as GAPI
participant "QdrantService" as QS
participant "Qdrant API" as QAPI

== Generate Embeddings (Batch) ==

DS -> GES: GenerateBatchEmbeddingsAsync(chunks)
activate GES

note right of GES
**Input:**
chunks = [
  "Chunk 0 content...",
  "Chunk 1 content...",
  "Chunk 2 content..."
]
end note

loop For each chunk in batch
    GES -> GAPI: POST /v1beta/models/text-embedding-004:embedContent
    activate GAPI
    
    note right of GAPI
    **Request Body:**
    {
      "content": {
        "parts": [{"text": chunk}]
      },
      "taskType": "RETRIEVAL_DOCUMENT"
    }
    end note
    
    GAPI -> GAPI: Generate 768-dim vector
    
    GES <-- GAPI: {\n  "embedding": {\n    "values": [0.123, -0.456, ...]\n  }\n}
    deactivate GAPI
    
    GES -> GES: Store embedding in list
end

DS <-- GES: List<float[]> embeddings\n(768 dimensions each)
deactivate GES

== Store Vectors in Qdrant ==

loop For each embedding (i = 0 to N)
    DS -> DS: vectorId = "{groupId}_{docId}_{i}"
    
    DS -> DS: Build payload:\n{\n  "groupId": "uuid",\n  "documentId": "uuid",\n  "userId": "uuid",\n  "chunkIndex": i,\n  "chunkCount": N,\n  "content": chunks[i],\n  "fileName": "doc.pdf",\n  "fileKey": "group_xxx/doc_yyy.pdf",\n  "embeddingModel": "text-embedding-004",\n  "createdAt": "2024-03-10T...",\n  "deleted": false\n}
    
    DS -> QS: UpsertVectorAsync(vectorId, embedding[i], payload)
    activate QS
    
    QS -> QAPI: POST /collections/studystudio_documents/points/upsert
    activate QAPI
    
    note right of QAPI
    **Request Body:**
    {
      "points": [{
        "id": vectorId,
        "vector": [768 floats],
        "payload": {metadata}
      }]
    }
    end note
    
    QAPI -> QAPI: Store vector + payload\nin collection
    
    QS <-- QAPI: {"status": "ok"}
    deactivate QAPI
    
    DS <-- QS: true
    deactivate QS
end

DS -> DS: Update GroupAttachment\nstatus = Completed\nchunkCount = N

note right of DS
**Vector Storage Complete**

Total vectors: N chunks
Vector ID format: {groupId}_{docId}_{index}
Payload includes full metadata
Ready for semantic search
end note

== Later: Search Query ==

participant "AIService" as AS

AS -> GES: GenerateEmbeddingAsync(question)
activate GES
GES -> GAPI: POST /v1beta/models/text-embedding-004:embedContent\n(taskType: RETRIEVAL_QUERY)
activate GAPI
GES <-- GAPI: questionEmbedding[768]
deactivate GAPI
AS <-- GES: float[] queryVector
deactivate GES

AS -> QS: SearchVectorsAsync(queryVector, topK=3, groupId)
activate QS

QS -> QAPI: POST /collections/studystudio_documents/points/search
activate QAPI

note right of QAPI
**Search Request:**
{
  "vector": [768 floats],
  "limit": 3,
  "with_payload": true,
  "filter": {
    "must": [{
      "key": "groupId",
      "match": {"value": groupId}
    }]
  }
}
end note

QAPI -> QAPI: Cosine similarity search\nFilter by groupId\nSort by score DESC

QS <-- QAPI: {\n  "result": [\n    {id, score, payload},\n    {id, score, payload},\n    {id, score, payload}\n  ]\n}
deactivate QAPI

QS -> QS: Parse results\nExtract top 3 chunks

AS <-- QS: List<SearchResult>
deactivate QS

note right of AS
**Search Results:**
Top 3 most relevant chunks
Score: 0.0 to 1.0
Payload includes content
Ready for LLM context
end note

@enduml
