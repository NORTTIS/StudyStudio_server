@startuml Qdrant Vector Structure
!theme plain
skinparam backgroundColor #FEFEFE

title Qdrant Vector Database Structure

package "Qdrant Collection: studystudio_documents" {
    
    component "Vector" as V {
        [768 float dimensions]
        note right: Cosine similarity metric
    }
    
    component "Payload (Metadata)" as P {
        map "Standard Fields" as SF {
            groupId => "uuid string" (indexed)
            documentId => "uuid string" (indexed)
            userId => "uuid string"
            chunkIndex => integer
            chunkCount => integer
            content => "text string" (searchable)
            fileName => "text string"
            fileKey => "text string"
            embeddingModel => "text-embedding-004"
            createdAt => "ISO timestamp"
            deleted => boolean (indexed)
        }
    }
}

note right of V
**Vector Properties:**
- Size: 768 dimensions
- Type: float32
- Distance: Cosine
- Generated by: Gemini text-embedding-004
end note

note right of P
**Payload Usage:**
- groupId: Filter documents by group
- chunkIndex: Identify chunk position
- content: Full text for context
- deleted: Soft delete flag
end note

cloud "Example Vector Point" as EX {
    card "Point ID" as PID {
        **Format**: {groupId}_{documentId}_{chunkIndex}
        **Example**: 
        abc123...def_789xyz...456_0
        abc123...def_789xyz...456_1
        abc123...def_789xyz...456_2
    }
    
    card "Vector Data" as VD {
        [0.0234, -0.1567, 0.2891, ...]
        (768 dimensions)
    }
    
    card "Payload Data" as PD {
        {
          "groupId": "abc123-...",
          "documentId": "789xyz-...",
          "userId": "user456-...",
          "chunkIndex": 0,
          "chunkCount": 15,
          "content": "D? án hi?n ðang...",
          "fileName": "project_report.pdf",
          "fileKey": "group_abc/doc_789.pdf",
          "embeddingModel": "text-embedding-004",
          "createdAt": "2024-03-10T14:30:00Z",
          "deleted": false
        }
    }
}

V -- EX
P -- EX

@enduml
