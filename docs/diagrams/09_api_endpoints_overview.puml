@startuml API Endpoints Overview
!theme plain
skinparam backgroundColor #FEFEFE

title API Endpoints - Document & AI Features

package "Document Management\n/api/documents" {
    
    usecase "POST /request-upload" as UC1 #LightBlue
    note right of UC1
    **Request Upload URL**
    Body: {groupId, fileName, contentType, fileSize}
    Response: {attachmentId, uploadUrl, fileKey}
    Auth: Required (Member)
    end note
    
    usecase "POST /{id}/complete" as UC2 #LightBlue
    note right of UC2
    **Complete Upload**
    Triggers background processing
    Response: {message}
    Auth: Required (Uploader)
    end note
    
    usecase "GET /{id}/status" as UC3 #LightGreen
    note right of UC3
    **Get Processing Status**
    Response: {status, chunkCount, progress, errorMessage}
    Status: Uploading | Processing | Completed | Failed
    Auth: Required (Member)
    end note
    
    usecase "GET /group/{groupId}" as UC4 #LightGreen
    note right of UC4
    **List Group Documents**
    Response: {documents[], totalCount}
    Include: FileName, Status, ChunkCount, Uploader
    Auth: Required (Member)
    end note
    
    usecase "DELETE /{id}" as UC5 #LightCoral
    note right of UC5
    **Delete Document**
    Soft delete + Remove from Qdrant
    Auth: Required (Uploader or Member)
    end note
}

package "AI Question & Answer\n/api/ai" {
    
    usecase "POST /ask" as UC6 #LightYellow
    note right of UC6
    **Ask AI Question**
    Body: {groupId, question}
    Response: {
      answer,
      sourceDocuments[],
      taskSummary,
      processingTimeMs
    }
    Auth: Required (Member)
    
    **Processing:**
    1. Embed question (Gemini)
    2. Search Qdrant (top 3)
    3. Query task stats (PostgreSQL)
    4. Build context
    5. Call LLM (Groq)
    end note
}

actor "Frontend User" as User
actor "Background Worker" as BG

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

UC2 ..> BG: triggers
BG ..> UC3: updates status

@enduml
